# Copy this file to .env. Unlike the rest of hazbot-web (mock data, mock
# auth — see README.md), the public listing page (src/app/listing/[token].tsx)
# is a real read against hazbot-mobile's Supabase project: it's that project's
# schema that owns units/share tokens and exposes the anon-callable
# get_public_unit(p_token) RPC. Use the SAME values as hazbot-mobile's own
# .env (Project Settings -> API) — this is intentionally the same project,
# not a separate one.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
